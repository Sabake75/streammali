FROM dunglas/frankenphp:php8.3

RUN install-php-extensions pdo_pgsql pgsql gd zip intl \
    && echo "opcache.enable=1" > "$PHP_INI_DIR/conf.d/opcache-enable.ini"

# The base image grants frankenphp cap_net_bind_service via a Linux file
# capability (setcap) so it can bind :80 without running as root. Render's
# sandboxed runtime (gVisor) refuses to exec a binary carrying that
# capability at all — even as root — and fails with a bare "Operation not
# permitted" (confirmed: getcap showed cap_net_bind_service=ep on this
# binary; this container never drops to a non-root user, so it doesn't
# need the capability in the first place — root can already bind any port).
RUN setcap -r /usr/local/bin/frankenphp

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction

COPY . .

# .dockerignore excludes these (shared with the dev Dockerfile, which never
# copies app code at all) so they don't exist in the build context — Laravel
# requires the directories themselves to exist even though their contents
# are runtime-only and deliberately excluded.
RUN mkdir -p storage/framework/sessions storage/framework/views storage/framework/cache/data storage/logs

RUN composer dump-autoload --optimize --no-dev

COPY docker/entrypoint.prod.sh /usr/local/bin/entrypoint.prod.sh
RUN chmod +x /usr/local/bin/entrypoint.prod.sh \
    && chown -R www-data:www-data storage bootstrap/cache

# Documentation only — the actual bind port is decided at runtime by
# entrypoint.prod.sh (Render provides $PORT, not necessarily 80).
EXPOSE 80

ENTRYPOINT ["entrypoint.prod.sh"]
CMD ["frankenphp", "php-server", "--root", "public/"]
