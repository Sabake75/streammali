APP_NAME=StreamMali
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=streammali
DB_USERNAME=streammali
DB_PASSWORD=streammali

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# "dev" tant que seul le produit sandbox "Orange Money WebPay Dev" est
# approuvé côté Developer Center — repasser à "ml" une fois l'abonnement de
# production approuvé (voir config/services.php).
ORANGE_MONEY_BASE_URL=https://api.orange.com
ORANGE_MONEY_COUNTRY=dev
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
# Sans le point final affiché sur le Developer Center (ex: 35ec1887, pas
# 35ec1887.) — voir App\Domain\Payment\Gateways\OrangeMoneyGateway.
ORANGE_MONEY_MERCHANT_KEY=
# Orange rejette localhost/127.0.0.1 sur ces 3 URLs (même en sandbox) : pour
# tester le flux complet redirect+webhook il faut des URLs publiques (voir
# infra/DEPLOY.md) — un test en local ne peut valider que l'appel API brut.
ORANGE_MONEY_RETURN_URL=http://localhost:3000/paiement/succes
ORANGE_MONEY_CANCEL_URL=http://localhost:3000/paiement/annule
ORANGE_MONEY_NOTIF_URL=http://localhost:8000/api/webhooks/orange-money

PAYDUNYA_BASE_URL=https://app.paydunya.com/api/v1
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_RETURN_URL=http://localhost:3000/paiement/succes
PAYDUNYA_CANCEL_URL=http://localhost:3000/paiement/annule
PAYDUNYA_CALLBACK_URL=http://localhost:8000/api/webhooks/paydunya

CORS_ALLOWED_ORIGINS=http://localhost:3000

PLATFORM_COMMISSION_RATE=0.25
PLATFORM_MINIMUM_PAYOUT_AMOUNT=10000

CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_MAX_DURATION_SECONDS=7200
CLOUDFLARE_STREAM_PREVIEW_DURATION_SECONDS=45

# Optionnel : laissé vide, le SDK Sentry reste inactif (aucun compte
# Sentry lié à ce projet pour l'instant). Le définir active le suivi
# d'erreurs en production sans aucun autre changement de code.
SENTRY_LARAVEL_DSN=

VITE_APP_NAME="${APP_NAME}"
