NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Optionnel : URL utilisée uniquement par les fetch SSR (server components), quand elle diffère
# de celle du navigateur (ex. nom de service Docker). Non définie en dev natif.
# API_INTERNAL_URL=http://api:8000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optionnel : laissés vides, le SDK Sentry reste inactif (aucun compte
# Sentry lié à ce projet pour l'instant). Les définir active le suivi
# d'erreurs en production sans aucun autre changement de code — penser à
# aussi ajouter le domaine d'ingestion Sentry à la CSP (next.config.ts).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
